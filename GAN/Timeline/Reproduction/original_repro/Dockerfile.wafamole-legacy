FROM python:3.7.4-slim-buster

ENV PYTHONUNBUFFERED=1
ENV TF_CPP_MIN_LOG_LEVEL=3

WORKDIR /workspace

RUN sed -i 's|http://deb.debian.org/debian|http://archive.debian.org/debian|g' /etc/apt/sources.list \
    && sed -i 's|http://security.debian.org/debian-security|http://archive.debian.org/debian-security|g' /etc/apt/sources.list \
    && sed -i '/buster-updates/d' /etc/apt/sources.list \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

COPY Timeline/Reproduction/original_repro/wafamole_legacy_requirements.txt /tmp/wafamole_legacy_requirements.txt

RUN python -m pip install --upgrade pip==20.3.4 setuptools==44.1.1 wheel==0.37.1 \
    && python -m pip install --no-cache-dir -r /tmp/wafamole_legacy_requirements.txt

ENV PYTHONPATH=/workspace/Timeline/Reproduction/external/WAF-A-MoLE
